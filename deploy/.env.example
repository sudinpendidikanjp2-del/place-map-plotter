# Salin menjadi deploy/.env lalu isi. Jangan pernah memasukkan berkas .env ke git.
DOMAIN=peta.contoh.go.id
POSTGRES_PASSWORD=ganti-dengan-sandi-acak-panjang

# Kunci web: dibatasi referrer HTTP ke https://DOMAIN/* di Google Cloud Console.
GOOGLE_MAPS_KEY=
# ID peta bergaya (Map Management) dengan "Advanced Markers" aktif.
GOOGLE_MAP_ID=
# Kunci server untuk ekspor gambar peta: API Static Maps, dibatasi IP VPS.
STATIC_MAPS_KEY=
DB_POOL_SIZE=10
