# Server
DATABASE_URL=postgres://sekolah:dev@localhost:5432/peta
PORT=3000
NODE_ENV=development
# true di belakang Caddy agar IP asli dibaca dari X-Forwarded-For
TRUST_PROXY=false
# Asal tambahan yang boleh menulis (pisahkan dengan koma), selain host yang sama
ALLOWED_ORIGINS=
# Kunci Google Static Maps untuk ekspor gambar peta, dibatasi IP server di Google Cloud Console
STATIC_MAPS_KEY=
MAX_UPLOAD_MB=2048
DB_POOL_SIZE=10

# Kunci Maps untuk web, dikirim ke peramban lewat /api/config saat runtime. Terlihat di klien, wajib dibatasi referrer HTTP.
GOOGLE_MAPS_KEY=
# ID peta bergaya dari Google Cloud Console (Map Management), diperlukan oleh AdvancedMarker
GOOGLE_MAP_ID=
